rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/calibration/examples.bin {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
        && (request.resource == null ||
            (request.resource.size < 40 * 1024 * 1024 &&
             request.resource.contentType == 'application/octet-stream'));
    }
    match /users/{userId}/recordings/{recordingId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
        && (request.resource == null ||
            (request.resource.size < 10 * 1024 * 1024 &&
             request.resource.contentType.matches('audio/.*')));
    }
    match /users/{userId}/recordings/{allPaths=**} {
      allow list: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/deleted/{recordingId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
        && (request.resource == null ||
            (request.resource.size == 0 &&
             request.resource.contentType == 'application/octet-stream'));
    }
    match /users/{userId}/deleted/{allPaths=**} {
      allow list: if request.auth != null && request.auth.uid == userId;
    }
  }
}
